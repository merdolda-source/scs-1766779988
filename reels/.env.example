# ─── Veri ────────────────────────────────────────────────────────────────────
# Boş bırakılırsa sporx'ten doğrudan okunur (önerilen).
# Kendi PHP uçlarını kullanmak istersen adresi buraya yaz.
DATA_BASE_URL=
DATA_LIG=super-lig
TEAM_NAME=Galatasaray
TEAM_SHORT=GS

# ─── Instagram ───────────────────────────────────────────────────────────────
# IG_MODE=instagram  -> "Instagram Login" (Facebook Sayfası GEREKMEZ) — önerilen
# IG_MODE=facebook   -> "Facebook Login"  (Facebook Sayfası gerekir)
IG_MODE=instagram
IG_APP_ID=
IG_APP_SECRET=
# Aşağıdaki ikisini `node src/ig-setup.mjs --token <kısa-token>` üretir:
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_HANDLE=@just_taraftar

# ─── Video barındırma (S3 uyumlu: Cloudflare R2, AWS S3, ...) ────────────────
# Instagram videoyu herkese açık bir URL'den çeker; kova PUBLIC olmalı.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE=

# ─── Paylaşım ritmi ──────────────────────────────────────────────────────────
POSTS_PER_DAY=2
POSTS_MATCH_DAY=4
QUIET_DAY_CHANCE=0.15
POST_SLOTS=11:00,19:30
TZ_NAME=Europe/Istanbul
